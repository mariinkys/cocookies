GITHUB_REPOSITORY=mariinkys/cocookies

# Path of the SQLite file (legacy "jdbc:sqlite:..." values are accepted too)
DB_URL=cocookies.db
# Long random string used to sign session tokens, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ALLOWED_ORIGIN=http://localhost:8080
# Set to true when served over HTTPS
COOKIE_SECURE=false
# Set to true when running behind the bundled nginx (or another proxy you control)
TRUST_PROXY=false
# Let visitors browse shared recipes without an account (read only)
GUEST_ACCESS=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Log verbosity, e.g. "debug" or "info,sqlx=debug"
RUST_LOG=info,sqlx=warn
